      "rank": "class",
      "guide": {
        "name": "Liliopsida",
        "text": "Monocotiledóneas: un cotiledón; son frecuentes la nerviación paralela y las flores trímeras.",
        "contrast": "Combinar rasgos: hay excepciones a los patrones foliares y florales.",
        "source": "https://openstax.org/books/biology-2e/pages/26-3-angiosperms"
