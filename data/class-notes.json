      "name": "Lycopodiopsida",
      "rank": "class",
      "guide": {
        "name": "Lycopodiopsida",
        "text": "Licófitos vasculares con hojas generalmente pequeñas y una sola vena. Producen esporas en esporangios.",
        "contrast": "Algunos agrupan las hojas portadoras de esporangios en conos. Los licófitos fósiles incluyen formas arborescentes.",
        "source": "https://www.nzplants.auckland.ac.nz/en/about/lycophytes/overview.html"
      }
    },
    "class:Magnoliopsida": {
      "name": "Magnoliopsida",
      "rank": "class",
      "guide": {
        "name": "Magnoliopsida",
        "text": "Nombre de clase con circunscripción variable entre sistemas, asociado aquí a numerosas dicotiledóneas.",
        "contrast": "Dos cotiledones y nerviación reticulada son orientativos; no equivale automáticamente al clado de las eudicotiledóneas.",
        "source": "https://openstax.org/books/biology-2e/pages/26-3-angiosperms"
      }
