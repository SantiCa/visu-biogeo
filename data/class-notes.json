    "class:Polypodiopsida": {
      "name": "Polypodiopsida",
      "rank": "class",
      "guide": {
        "name": "Polypodiopsida",
        "text": "Helechos y grupos afines según la fuente; reproducción por esporas, sin flores ni semillas.",
        "contrast": "Los soros son útiles en muchos helechos, pero no aparecen como puntos foliares en todos los grupos.",
