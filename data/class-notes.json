    "class:Actinopterygii": {
      "name": "Actinopterygii",
      "rank": "class",
      "guide": {
        "name": "Actinopterygii",
        "text": "Peces óseos cuyas aletas se sostienen mediante radios.",
        "contrast": "Frente a los condrictios, predomina un esqueleto osificado; observar también las aletas.",
        "source": "https://openstax.org/books/biology-2e/pages/29-2-fishes"
      }
    },
    "class:Agaricomycetes": {
      "name": "Agaricomycetes",
      "rank": "class"
    },
    "class:Amphibia": {
      "name": "Amphibia",
      "rank": "class",
      "guide": {
        "name": "Amphibia",
        "text": "Tetrápodos de piel generalmente permeable; muchos tienen larvas acuáticas y metamorfosis.",
        "contrast": "Frente a los amniotas, no presentan el huevo amniótico; hay ciclos vitales diversos.",
        "source": "https://openstax.org/books/biology-2e/pages/29-3-amphibians"
      },
      "etymology": {
        "text": "Se relaciona con el griego amphíbios y el latín amphibion, referido a un animal que vive en tierra y agua. Es el sentido histórico del nombre, no una regla sin excepciones sobre su ciclo.",
        "url": "https://dle.rae.es/anfibio"
      }
    },
    "class:Andreaeopsida": {
      "name": "Andreaeopsida",
      "rank": "class"
    },
    "class:Anthozoa": {
      "name": "Anthozoa",
      "rank": "class",
      "guide": {
        "name": "Anthozoa",
        "text": "Anémonas y corales: organización de pólipo, solitario o colonial.",
        "contrast": "No presentan una fase de medusa en su ciclo.",
        "source": "https://openstax.org/books/biology-2e/pages/28-2-phylum-cnidaria"
      }
    },
    "class:Arachnida": {
      "name": "Arachnida",
      "rank": "class",
      "guide": {
        "name": "Arachnida",
        "text": "Quelíceros, pedipalpos y, típicamente en adultos, cuatro pares de patas.",
        "contrast": "No tienen antenas. El recuento de patas puede cambiar en fases juveniles de algunos grupos.",
        "source": "https://openstax.org/books/biology-2e/pages/28-6-superphylum-ecdysozoa-arthropods"
      },
      "etymology": {
        "text": "La raíz arachn- remite al griego aráchnē, araña; el DLE documenta esa raíz en arácnido.",
        "url": "https://dle.rae.es/arácnido"
      }
    },
